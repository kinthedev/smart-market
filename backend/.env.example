# Môi trường chạy (development | production)
NODE_ENV=development
PORT=4000

# Kết nối PostgreSQL (hỗ trợ SSL connection string từ Neon, Supabase, Render Postgres)
DATABASE_URL="postgresql://username:password@localhost:5432/smart_market_db"

# Khóa bí mật cho Better Auth (tạo bằng lệnh: openssl rand -base64 32)
BETTER_AUTH_SECRET="your-super-secret-key-min-32-chars"

# URL Backend (Production BẮT BUỘC: https://your-backend.onrender.com)
# Không dùng localhost ở production vì sẽ làm Google OAuth redirect sai.
BETTER_AUTH_URL="http://localhost:4000"

# URL Frontend (Production BẮT BUỘC: https://your-frontend.vercel.app)
# Đây là nơi người dùng được đưa về sau khi đăng nhập Google/Facebook.
FRONTEND_URL="http://localhost:3000"

# OAuth providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
FACEBOOK_CLIENT_ID="your-facebook-app-id"
FACEBOOK_CLIENT_SECRET="your-facebook-app-secret"

# Tài khoản quản trị (admin) lấy trực tiếp từ biến môi trường.
# Đổi email/mật khẩu tại đây rồi restart backend là xong, không cần sửa database.
# Backend sẽ tự đồng bộ tài khoản này vào database lúc khởi động.
# BẮT BUỘC khai báo ở production.
ADMIN_EMAIL="admin@smartmarket.com"
ADMIN_PASSWORD="doi-mat-khau-that-manh"
# Tên hiển thị của admin (không bắt buộc)
ADMIN_NAME="Quản trị viên"


