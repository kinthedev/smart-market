# Môi trường chạy (development | production)
NODE_ENV=development
PORT=4000

# Kết nối PostgreSQL (hỗ trợ SSL connection string từ Neon, Supabase, Render Postgres)
DATABASE_URL="postgresql://username:password@localhost:5432/smart_market_db"

# Khóa bí mật cho Better Auth (tạo bằng lệnh: openssl rand -base64 32)
BETTER_AUTH_SECRET="your-super-secret-key-min-32-chars"

# URL Backend (Render: https://your-backend.onrender.com)
BETTER_AUTH_URL="http://localhost:4000"

# URL Frontend (Vercel: https://your-frontend.vercel.app)
FRONTEND_URL="http://localhost:3000"

